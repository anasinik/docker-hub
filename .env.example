# Copy to .env and adjust. Never commit the real .env file.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# ON  -> SQLite + local memory cache (tests, CI, local development)
# OFF -> PostgreSQL + Redis (docker compose / production)
UKS_TEST_DB=ON

# PostgreSQL (used when UKS_TEST_DB=OFF)
POSTGRES_DB=dockerhub
POSTGRES_USER=dockerhub
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis (used when UKS_TEST_DB=OFF)
REDIS_URL=redis://redis:6379/0

# Logging: DEBUG, INFO, WARNING, ERROR or CRITICAL
DJANGO_LOG_LEVEL=INFO
# Directory for app.log and app.json.log (default: <project>/logs)
DJANGO_LOG_DIR=
# False -> console only, no log files
DJANGO_LOG_TO_FILE=True
