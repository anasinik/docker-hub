# Copy to .env and adjust. Never commit the real .env file.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUSTED_PROXY_IPS=172.30.0.2/32

# ON  -> SQLite + local memory cache (tests, CI, local development)
# OFF -> PostgreSQL + Redis (docker compose / production)
UKS_TEST_DB=ON

# PostgreSQL (used when UKS_TEST_DB=OFF)
POSTGRES_DB=dockerhub
POSTGRES_USER=dockerhub
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis (used when UKS_TEST_DB=OFF)
REDIS_URL=redis://redis:6379/0

# Elasticsearch (log analytics)
# Password of the built-in "elastic" user, used by docker compose and the app
ELASTIC_PASSWORD=change-me
# http://elasticsearch:9200 when the app runs inside docker compose
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_LOG_INDEX=dockerhub-logs

# Container registry (Distribution, docker compose service "registry")
# Host port of the registry; docker push/pull use localhost:<port>
REGISTRY_PORT=5000
# http://registry:5000 when the app runs inside docker compose
REGISTRY_URL=http://localhost:5000
# Seconds to wait for the registry
REGISTRY_TIMEOUT=5
# MockRegistryClient (default, no registry needed) or HttpRegistryClient
REGISTRY_CLIENT_CLASS=repositories.services.registry.mock.MockRegistryClient

# Registry token authentication (see README, "Registry authentication")
# Token endpoint address the Docker daemon calls. With runserver on the host:
# run "manage.py runserver 0.0.0.0:8000" and add host.docker.internal to DJANGO_ALLOWED_HOSTS.
REGISTRY_TOKEN_REALM=http://host.docker.internal:8000/registry/token/
# Must match auth.token in docker/registry/config.yml
REGISTRY_TOKEN_SERVICE=dockerhub-registry
REGISTRY_TOKEN_ISSUER=dockerhub-token-issuer
# Signing key, created by "manage.py generate_registry_keys" (default: docker/registry/auth/token.key)
REGISTRY_TOKEN_PRIVATE_KEY_PATH=
# Token lifetime in seconds
REGISTRY_TOKEN_TTL=300

# Super admin created by "manage.py setup_super_admin" (see README, "Setup")
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_EMAIL=superadmin@example.com
# File the generated password is written to (default: secrets/superadmin_password.txt)
SUPER_ADMIN_PASSWORD_FILE=

# Logging: DEBUG, INFO, WARNING, ERROR or CRITICAL
DJANGO_LOG_LEVEL=INFO
# Directory for app.log and app.json.log (default: <project>/logs)
DJANGO_LOG_DIR=
# False -> console only, no log files
DJANGO_LOG_TO_FILE=True
